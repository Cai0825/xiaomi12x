# Droidspaces on Xiaomi 12X (psyche) / PixelOS 17
# Exact kernel baseline:
#   Rocky7842/android_kernel_xiaomi_sm8250 @ 59aa6cf45839
#
# This fragment deliberately enables only the hard requirements and devtmpfs.
# Optional feature switches that can resize core kernel structures are left off
# so the existing vendor modules keep their expected ABI.
#
# Reference:
#   https://github.com/ravindu644/Droidspaces-OSS/blob/main/Documentation/Kernel-Configuration.md

# Namespace support
CONFIG_NAMESPACES=y
CONFIG_UTS_NS=y
CONFIG_PID_NS=y

# IPC namespace and its Kconfig prerequisites
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_IPC_NS=y

# Droidspaces hard requirements already used by the device
CONFIG_SECCOMP=y
CONFIG_SECCOMP_FILTER=y
CONFIG_CGROUPS=y

# Optional in Droidspaces, but enables hardware access mode
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Keep the exact vermagic suffix used by the installed vendor modules.
# localversion-cip and localversion-st provide the -cip135-st19 prefix.
CONFIG_LOCALVERSION="-perf-g59aa6cf45839-dirty"
# CONFIG_LOCALVERSION_AUTO is not set

# Keep the settings below off for the first build. They are optional features
# and CGROUP_PIDS/USER_NS may change structure layouts used by vendor modules.
# CONFIG_USER_NS is not set
# CONFIG_CGROUP_PIDS is not set
# CONFIG_CFS_BANDWIDTH is not set
